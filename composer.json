{
    "name": "kiki/courier",
    "description": "CLI for courier pricing and scheduling",
    "type": "project",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "vendor\\bin\\phpunit --colors=always",
        "cs-fix": "vendor\\bin\\php-cs-fixer fix --config=.php-cs-fixer.php"
    }
}
